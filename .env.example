# Backend (FastAPI)
# =====================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173


# =====================
# Database (PostgreSQL)
# =====================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=app_db
