# =========================
# PostgreSQL (used by db container)
# =========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salarydb

# =========================
# SQLAlchemy (used by backend)
# IMPORTANT: host must be "db"
# =========================
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/salarydb

# =========================
# Backend
# =========================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGINS="http://localhost:3000"

# =========================
# Frontend
# =========================
VITE_API_BASE_URL=http://localhost:8000
