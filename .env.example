# SQLAlchemy style URL (example uses psycopg driver)
DATABASE_URL=postgresql+psycopg://app_user:change-me@db:5432/app_db

# =====================
# Frontend (Vite)
# =====================
VITE_API_BASE_URL=http://localhost:8000

