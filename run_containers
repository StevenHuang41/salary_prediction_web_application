#!/usr/bin/env bash

set -e

NETWORK=salary_net
DB_CONTAINER=salary_db
BACKEND_CONTAINER=salary_backend
FRONTEND_CONTAINER=salary_frontend

BACKEND_IMAGE=yenjung41/salary-backend
FRONTEND_IMAGE=yenjung41/salary-frontend

PROJECT_ROOT=$(pwd)

echo "Creating docker network..."

docker network create $NETWORK 2>/dev/null || true

echo "Pulling images..."

docker pull $BACKEND_IMAGE
docker pull $FRONTEND_IMAGE
docker pull postgres:16

echo "Starting postgres container..."

docker rm -f $DB_CONTAINER 2>/dev/null || true

docker run -d \
  --name $DB_CONTAINER \
  --network $NETWORK \
  -e POSTGRES_USER=postgres \
  -e POSTGRES_PASSWORD=postgres \
  -e POSTGRES_DB=salarydb \
  -p 5432:5432 \
  postgres:16

echo "Starting backend container..."

docker rm -f $BACKEND_CONTAINER 2>/dev/null || true

docker run -d \
  --name $BACKEND_CONTAINER \
  --network $NETWORK \
  -e DATABASE_URL=postgresql+psycopg://postgres:postgres@salary_db:5432/salarydb \
  -p 8080:8080 \
  $BACKEND_IMAGE

echo "Starting frontend container..."

docker rm -f $FRONTEND_CONTAINER 2>/dev/null || true

docker run -d \
  --name $FRONTEND_CONTAINER \
  --network $NETWORK \
  -p 3000:80 \
  $FRONTEND_IMAGE

echo ""
echo "System started successfully"
echo ""
echo "Frontend: http://localhost:3000"
echo "Backend:  http://localhost:8080/docs"
echo "Postgres: localhost:5432"
